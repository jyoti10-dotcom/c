#include <stdio.h>

int main(void)
{
	int balance;
	int withdrawal;

	printf("Enter account balance: ");
	if (scanf("%d", &balance) != 1) 
  {
		printf("Rejected: invalid account balance.\n");
		return 1;
	}

	printf("Enter withdrawal amount: ");
	if (scanf("%d", &withdrawal) != 1) 
  {
		printf("Rejected: invalid withdrawal amount.\n");
		return 1;
	}

	if (withdrawal <= 0) 
  {
		printf("Rejected: withdrawal amount must be greater than 0.\n");
	} 
  else 
  if (withdrawal > balance) 
  {
		printf("Rejected: withdrawal amount exceeds the balance.\n");
	} 
  else 
  if (withdrawal % 100 != 0)
  {
		printf("Rejected: withdrawal amount must be a multiple of Rs. 100.\n");
	} 
  else 
  {
		printf("Accepted\n");
	}

	return 0;
}
