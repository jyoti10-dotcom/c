#include <stdio.h>

int main()
{
	int units;
	int rate;
	int bill;

	printf("Enter units consumed: ");
	if (scanf("%d", &units) != 1 || units < 0) 
  {
		printf("Invalid units.\n");
		return 1;
	}

	if (units <= 100) 
  {
		rate = 5;
	} else if (units <= 200) 
  {
		rate = 7;
	} else {
		rate = 10;
	}

	bill = units * rate;
	printf("Estimated bill: Rs. %d\n", bill);

	return 0;
}
